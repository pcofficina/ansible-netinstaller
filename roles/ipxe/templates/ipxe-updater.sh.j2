#!/bin/sh

IPXE_URL="https://boot.ipxe.org"
IPXE_FILE_LIST="{{ ipxe_file_list | join(' ') }}"
TODAY=`date +%Y%m%d`
TFTP_BOOT={{ ipxe_basedir }}

if [ -d $TFTP_BOOT ]; then
        cd $TFTP_BOOT;
else
        echo "ERROR: Missing TFTP root path: $TFTP_BOOT. Exiting"
        exit 1
fi

for IPXE_FILE in $IPXE_FILE_LIST; do
    # This strips everything up to the last slash (e.g., "x86_64-efi/ipxe.efi" becomes "ipxe.efi")
    FILENAME="${IPXE_FILE##*/}"

    curl "$IPXE_URL/$IPXE_FILE" -o "$FILENAME.$TODAY" && \
    rm -f "$FILENAME" && \
    ln "$FILENAME.$TODAY" "$FILENAME"
done
